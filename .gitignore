# --- 依赖库 (最重要的部分，绝对不要提交) ---
node_modules/
.pnp
.pnp.js

# --- 生产构建目录 (通常不需要提交) ---
# build/
# dist/

# --- 环境变量 (Part 3 后端开发时非常重要，防止泄露密码) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- 操作系统生成的垃圾文件 ---
.DS_Store
Thumbs.db

# --- 日志文件 ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- 编辑器配置 (可选) ---
.vscode/
.idea/